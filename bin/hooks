#!/usr/bin/env bash
# Register or remove this plugin's Claude Code hooks in ~/.claude/settings.json, and its opencode TUI
# plugin in opencode's cli.json.
#
# Usage: hooks --install | --remove | --status | --relink
#
# Both files are also written by the agents themselves and by other tools (herdr's own integrations
# among them). So this only ever touches its own entries and leaves everything else alone.
set -u

# shellcheck source=bin/lib.sh
. "${0%/*}/lib.sh"

bin_dir=${0%/*}
case "$bin_dir" in /*) ;; *) bin_dir="$PWD/$bin_dir" ;; esac

# link_to <target> <link>: point a stable link at this installation (see lib.sh for why both agents
# are registered through a link rather than the installation path).
link_to() { mkdir -p "$state_dir" && ln -sfn "$1" "$2"; }

# write_if_changed <file> <json>: write back through the path, never over it. settings.json is
# commonly a symlink into a dotfiles working tree, and `mv`-ing a temporary file onto it would replace
# the link with a regular file. Installing again is the normal case, and a file that lives in a
# dotfiles tree should not be rewritten — reformatted by jq — when nothing changed.
write_if_changed() {
    [ "$2" = "$(jq . "$1")" ] && return 0
    printf '%s\n' "$2" >"$1"
}

# Claude runs a hook command through /bin/sh, so a registered path that does not exist on this
# machine fails *before* bin/report can decline quietly: Claude shows `No such file or directory`
# on every turn, four times over. That is not hypothetical — ~/.claude/settings.json is commonly a
# symlink into a dotfiles tree shared by several machines (issue #1), and on one of them the link may
# not exist yet. So the command carries its own existence check and exits 0 when the script is gone.
#
# `exec` keeps the hook payload on stdin and spends no extra process.
sh_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# The link is written relative to $HOME when it sits under it, which is the default: /bin/sh expands
# it when the hook runs, so a settings.json shared between machines reads the same on every one of
# them — /home/<user> on one, /Users/<user> on another. A state directory outside $HOME is written
# as an absolute path, and then only machines with that same path can share the file.
# shellcheck disable=SC2016  # $HOME and $p are for /bin/sh to expand, not this shell.
hook_command() {
    local report="$bin_link/report" word
    case "$report" in
        "$HOME"/*) word="\"\$HOME\"$(sh_quote "${report#"$HOME"}")" ;;
        *) word=$(sh_quote "$report") ;;
    esac
    printf 'p=%s; [ -x "$p" ] || exit 0; exec "$p"  # %s\n' "$word" "$marker"
}

# Ownership is decided by this marker, not by the command string or the path inside it: entries
# written before the link named an installation directly, and those have to be found and replaced
# whatever path they hold. A path fragment would not do either — a directory with an apostrophe in
# it splits the fragment apart once quoted. herdr's own Claude integration marks its hook the same
# way, with `# HERDR_INTEGRATION_ID=claude`. Entries written before the marker existed are plain
# absolute paths that contain the plugin directory name, so this same marker sweeps them too.
marker='herdr-agent-mode'

# The events that carry permission_mode, SessionStart for the model (#4), and SessionEnd, which means
# the agent is gone. bin/report says which carries what.
events=(SessionStart UserPromptSubmit PreToolUse Stop SessionEnd)

# How many entries of ours settings.json holds.
owned_count() {
    jq --arg marker "$marker" '
        [(.hooks // {}) | to_entries[] | .value[]? | (.hooks // [])[]?
         | select((.command // "") | contains($marker))] | length' "$settings_file" 2>/dev/null
}

# True when our entries are not what --install would write: one names another command (from before
# the link, an installation the next update removes), or an event has no entry with the current one
# (installed by a version that registered fewer events).
# shellcheck disable=SC2016  # jq program: $h, $marker, $cmd are jq variables.
hooks_outdated() {
    jq -e --arg marker "$marker" --arg cmd "$(hook_command)" '
        (.hooks // {}) as $h
        | def ours: [.[]? | (.hooks // [])[]? | .command // "" | select(contains($marker))];
          ([$h[] | ours[]] | any(. != $cmd))
          or ($ARGS.positional | any(. as $e | $h[$e] | ours | index($cmd) == null))' \
        --args "${events[@]}" <"$settings_file" >/dev/null 2>&1
}

# ── opencode ──────────────────────────────────────────────────────────────────

oc_dir="${bin_dir%/bin}/opencode"

# Ours in cli.json: the link, or a link this plugin left under another state directory (XDG_STATE_HOME
# changed between installs). herdr names the state directory after the plugin id, so the id in the
# path is what makes it ours; herdr's own entry and anything the user added never end in it.
# shellcheck disable=SC2016  # jq program: $p and $suffix are jq variables.
oc_ours='type == "string" and (. == $p or endswith($suffix))'
oc_jq() { jq --arg p "$opencode_link" --arg suffix "/$source_id/opencode" "$@"; }

oc_registered() {
    [ -f "$opencode_cli" ] && oc_jq -e "(.plugins // []) | any($oc_ours)" "$opencode_cli" >/dev/null 2>&1
}
# shellcheck disable=SC2016  # jq variable.
oc_stale() { oc_jq -e "(.plugins // []) | any(($oc_ours) and . != \$p)" "$opencode_cli" >/dev/null 2>&1; }

# oc_apply add|remove: sweep our entries out, then (for add) put the link back at the end. Says what
# went wrong itself and returns non-zero. herdr edits this file preserving its formatting; jq cannot,
# so a file with comments (JSONC) is refused rather than flattened.
oc_apply() {
    local updated
    if ! jq -e . "$opencode_cli" >/dev/null 2>&1; then
        echo "$opencode_cli is not plain JSON — $1 $opencode_link in its \"plugins\" by hand"
        return 1
    fi
    # shellcheck disable=SC2016  # jq variables.
    if ! updated=$(oc_jq --arg mode "$1" "
        .plugins = ([(.plugins // [])[] | select(($oc_ours) | not)] + (if \$mode == \"add\" then [\$p] else [] end))
        | if (.plugins | length) == 0 then del(.plugins) else . end" "$opencode_cli") ||
        ! write_if_changed "$opencode_cli" "$updated"; then
        echo "could not write $opencode_cli"
        return 1
    fi
}

# ── startup ───────────────────────────────────────────────────────────────────

# The startup hook. An update installs into a new directory, and the next server start runs this from
# there. Each link is (re)made wherever its file carries our entry — which is also how a second
# machine sharing settings.json gets its link without running the install action. The files are only
# read here: writing them stays an asked-for step, so Claude entries from before the link are
# reported, not rewritten.
if [ "${1:-}" = "--relink" ]; then
    command -v jq >/dev/null 2>&1 || exit 0
    if [ -e "$settings_file" ] && [ "$(owned_count)" -gt 0 ] 2>/dev/null; then
        [ "$bin_link" -ef "$bin_dir" ] || link_to "$bin_dir" "$bin_link"
        hooks_outdated && notify "Agent mode" "Claude hooks are out of date; run the install action once"
    fi
    if oc_registered; then
        [ "$opencode_link" -ef "$oc_dir" ] || link_to "$oc_dir" "$opencode_link"
        oc_stale && notify "Agent mode" "opencode's cli.json names an old path; run the install action once"
    fi
    exit 0
fi

die() {
    notify "Agent mode" "$1"
    echo "$1" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is required"

# Each agent is optional: a machine may run only one of them. Claude is skipped when it has no
# settings file yet, opencode when it has no cli.json (herdr's opencode integration creates it, and
# so does opencode 2.x on its first start).
have_claude=0
if [ -e "$settings_file" ]; then
    jq -e . "$settings_file" >/dev/null 2>&1 || die "$settings_file is not valid JSON — refusing to touch it"
    have_claude=1
fi

# Drop every entry of ours, wherever it sits. Both --install and --remove start here: installing
# runs the same sweep and then adds the link command back, so a stale entry cannot survive either
# operation and neither can a duplicate.
# shellcheck disable=SC2016  # jq program: $marker and $events are jq variables, not shell ones.
prune='.hooks //= {}
  | .hooks |= with_entries(.value = [.value[]
      | .hooks = [(.hooks // [])[] | select((.command // "") | contains($marker) | not)]
      | select((.hooks | length) > 0)])
  | .hooks |= with_entries(select((.value | length) > 0))'

# shellcheck disable=SC2016  # same: jq variables.
add='| reduce ($events | split(" "))[] as $event (.;
      .hooks[$event] //= []
      | .hooks[$event] += [{hooks: [{type: "command", command: $cmd, timeout: 5}]}])'

apply() {
    local updated
    updated=$(jq --arg cmd "$(hook_command)" --arg marker "$marker" --arg events "${events[*]}" \
        "$1" "$settings_file") || return 1
    write_if_changed "$settings_file" "$updated"
}

case "${1:---status}" in
    --install)
        [ "$have_claude" = 1 ] || [ -f "$opencode_cli" ] ||
            die "neither $settings_file nor $opencode_cli exists — start Claude Code or opencode once"
        claude_msg="Claude skipped" opencode_msg="opencode skipped"
        if [ "$have_claude" = 1 ]; then
            link_to "$bin_dir" "$bin_link" || die "could not link $bin_link -> $bin_dir"
            apply "$prune $add" || die "could not write $settings_file"
            claude_msg="$(owned_count) Claude hook(s)"
            echo "installed $claude_msg for ${events[*]}; running sessions pick this up"
        else
            echo "no Claude settings at $settings_file — skipped (start Claude Code once, or set CLAUDE_CONFIG_DIR)"
        fi
        if [ -f "$opencode_cli" ]; then
            link_to "$oc_dir" "$opencode_link" || die "could not link $opencode_link -> $oc_dir"
            if oc_apply add; then
                opencode_msg="opencode registered"
                echo "registered in $opencode_cli; opencode picks this up on its next start"
            else
                opencode_msg="opencode not registered"
            fi
        else
            echo "no opencode cli.json at $opencode_cli — skipped"
        fi
        notify "Agent mode installed" "$claude_msg, $opencode_msg"
        ;;
    --remove)
        if [ "$have_claude" = 1 ]; then
            apply "$prune" || die "could not write $settings_file"
            echo "removed this plugin's hooks from $settings_file"
        fi
        rm -f "$bin_link"
        [ -f "$opencode_cli" ] && oc_apply remove && echo "removed this plugin from $opencode_cli"
        rm -f "$opencode_link"
        notify "Agent mode removed" "run the clear action to drop the tokens already on panes"
        echo "run the clear action to drop the tokens already on your panes"
        ;;
    --status)
        count=
        [ "$have_claude" = 1 ] && count=$(owned_count)
        oc=no
        oc_registered && oc=yes
        notify "Agent mode" "${count:-0} Claude hook(s), opencode registered: $oc"
        echo "settings: $settings_file"
        echo "link:     $bin_link -> $(readlink "$bin_link" 2>/dev/null || echo "(none)")"
        echo "command:  $(hook_command)"
        echo "hooks installed: ${count:-0}"
        echo "opencode: $opencode_cli (registered: $oc)"
        echo "link:     $opencode_link -> $(readlink "$opencode_link" 2>/dev/null || echo "(none)")"
        ;;
    *)
        echo "usage: hooks --install | --remove | --status | --relink" >&2
        exit 2
        ;;
esac
exit 0
