#!/usr/bin/env bash
# Claude Code hook entry point: read the hook payload on stdin and report the pane's permission mode,
# model and reasoning effort.
#
# Registered for UserPromptSubmit, PreToolUse and Stop, which are the events that carry
# `permission_mode`; SessionStart, which carries the model instead (as of 2.1.330 the only event
# that does); and SessionEnd, which carries neither and means "clear the tokens".
#
# After SessionStart the model comes from the transcript, where every assistant message records the
# model that wrote it: Stop reads it there. That is how a `/model` switch reaches the sidebar — when
# the first turn under the new model ends.
#
# The effort is `effort.level` in the PreToolUse and Stop payloads — when the model has one: Claude
# leaves the field out for a model without it (Haiku), so on those two its absence clears the token.
# UserPromptSubmit and SessionStart never carry it (2.1.330, Sonnet at `high`), so there its absence
# says nothing. Only the level is reported here; bin/state draws it with the status, which this hook
# never writes — herdr's own Claude hooks report the status from these same events, and a status read
# here a moment too early would stay on screen. On Stop, bin/state is asked to redraw (restate), as
# herdr's own `done` event may have drawn the turn's end before this hook wrote the effort.
#
# This runs before every single tool call, so the work per run is kept to two processes: one jq to
# read the payload and one herdr to report it. Everything else is a bash builtin. Reading the
# transcript costs a few more, once a turn and in the background, never per tool call.
#
# Everything here fails closed and silently. A hook that writes to stderr or exits non-zero is a
# hook the user has to think about, and nothing this plugin does is worth interrupting a session
# for: at worst the sidebar keeps showing the previous mode.
set -u

# shellcheck source=bin/lib.sh
. "${0%/*}/lib.sh"

in_herdr_pane || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# One jq pass over stdin for every field. Reading the payload into a variable first and then running
# jq once per field would cost extra processes and temporary files (bash writes a here-string to
# disk); letting jq read stdin directly also drains it, so Claude Code never sees a broken pipe.
# The fields are joined with the unit separator, not a tab: a tab is IFS whitespace, so `read` would
# fold the two around an empty field into one and hand the next field to the wrong name.
IFS=$'\x1f' read -r event mode model transcript prompt_id effort < <(
    jq -r '[.hook_event_name, .permission_mode, .model, .transcript_path, .prompt_id, .effort.level?]
        | map(. // "") | join("\u001f")' \
        2>/dev/null
) || exit 0

# SessionEnd is the only reason this plugin ever clears a pane by itself: Claude is gone, so the
# mode and model it was running under are no longer true of that pane.
if [ "$event" = "SessionEnd" ]; then
    clear_pane "$HERDR_PANE_ID"
    exit 0
fi

# turn_model <transcript> <prompt_id>: the model of that turn's reply, once it is written — the last
# assistant entry after the user entry carrying the prompt id (assistant entries carry none). Only the
# end of the file is read; a line cut off by `tail` fails to parse and is skipped. Also skipped:
# subagent messages and the `<synthetic>` entries Claude writes for an API error, which no model wrote.
turn_model() {
    tail -c 262144 "$1" | jq -Rrn --arg p "$2" '
        reduce (inputs | fromjson? | objects) as $e (null;
            if $e.type == "user" and $e.promptId == $p then ""
            elif . != null and $e.type == "assistant" and ($e.isSidechain | not)
                and $e.message.model != "<synthetic>" then $e.message.model // .
            else . end) // empty' 2>/dev/null
}

# Stop carries no model, and its turn's reply is not in the transcript yet: Claude writes it after the
# hook returns. So the read runs in the background, after the mode has been reported, and gives up
# after three seconds.
if [ "$event" = "Stop" ] && [ -n "$prompt_id" ] && [ -r "$transcript" ]; then
    {
        for _ in {1..30}; do
            sleep 0.1
            found=$(turn_model "$transcript" "$prompt_id")
            [ -n "$found" ] && { publish "$HERDR_PANE_ID" "model=$found"; break; }
        done
    } </dev/null >/dev/null 2>&1 &
fi

# Only the fields this event carries are sent; publish leaves the others as they are. The effort is
# the exception on the events that would carry it, where its absence is itself the news.
#
# Claude's own modes, as of 2.1.285: default, acceptEdits, plan, auto, dontAsk, bypassPermissions.
effort_field=()
case "$event" in PreToolUse | Stop) effort_field=("effort=$effort") ;; esac
publish "$HERDR_PANE_ID" ${mode:+"mode=$mode"} ${model:+"model=$model"} "${effort_field[@]}"
[ "$event" = "Stop" ] && restate "$HERDR_PANE_ID"
exit 0
